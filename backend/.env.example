PORT=3010

# Set to true for local/dev without a real Sofie Core at CORE_HOST:CORE_PORT.
# Uses an in-process simulator: connection stays CONNECTED, ingest sync pushes are
# accepted (logged), content-status probes succeed (green Core SIM chip), and media
# readiness falls back to local filesystem checks. Production must leave this unset/false.
# SIMULATE_SOFIE_CORE=true

# Optional overrides when talking to a real Core (ignored URL for simulation display).
# CORE_HOST=127.0.0.1
# CORE_PORT=3000

# Root folder for staged ingest media. The media picker lists files from:
#   <INGEST_MEDIA_ROOT>/spravy/<rundownId>/clips/
# This mirrors the Caspar/Package Manager path layout used by sofie-demo-blueprints.
# Copy clips into that folder (not only into Caspar media) for the picker to see them.
# Can be overridden per-install in Settings → Connection → Ingest media root folder.
INGEST_MEDIA_ROOT=../ingest

# Base URL for GFX preview iframe templates. Use same-origin `/demo-assets` (recommended).
# The backend serves HTML from (first match wins):
#   1. GFX_TEMPLATES_ROOT — bind-mount sofie-demo-assets or hand-copied templates
#   2. {INGEST_MEDIA_ROOT}/gfx-templates/ — copy templates onto the NAS ingest share
#   3. Bundled demo-assets/ stubs in the app image
# Can be overridden per-install in Settings → Connection → GFX preview base URL.
PREVIEW_BASE_URL=/demo-assets

# Optional: absolute path to GFX HTML templates (Docker bind mount).
# Example: mount sofie-demo-assets dist and set GFX_TEMPLATES_ROOT=/app/gfx-templates
# GFX_TEMPLATES_ROOT=/app/gfx-templates

# Set to false when serving over plain HTTP (e.g. internal LAN) so session cookies work.
# Defaults to true in production (NODE_ENV=production), false otherwise.
# SESSION_COOKIE_SECURE=false
