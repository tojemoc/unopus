{
	"compilerOptions": {
		"target": "ES2015",
		"module": "CommonJS",
		"strict": true,
		"jsx": "preserve",
		"importHelpers": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"sourceMap": true,
		"lib": ["esnext", "dom", "dom.iterable", "scripthost"],
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.cts",
		"tests/**/*.ts",
		"tests/**/*.tsx",
		"src/preload.cts"
	],
	"exclude": ["node_modules"]
}
